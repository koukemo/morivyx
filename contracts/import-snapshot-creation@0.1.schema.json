{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:morivyx:import-snapshot-creation:0.1",
  "description": "初回取込を未承認のCore Artifactとして作成する要求。実行や真正性の確認は行わない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "artifactId", "changeSetId", "baseRevision", "baseRootDigest", "resultingRevision", "actor", "recordedAt", "manifest", "runRequest", "runResult"],
  "properties": {
    "format": { "const": "morivyx.import-snapshot-creation/0.1" },
    "artifactId": { "$ref": "#/$defs/id" },
    "changeSetId": { "$ref": "#/$defs/id" },
    "actor": { "$ref": "#/$defs/id" },
    "baseRevision": { "type": "string", "pattern": "^graph:\\S+$" },
    "baseRootDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "resultingRevision": { "type": "string", "pattern": "^graph:\\S+$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "manifest": { "$ref": "urn:morivyx:plugin-manifest:0.1" },
    "runRequest": { "$ref": "urn:morivyx:plugin-communication:0.1#/$defs/RunRequest" },
    "runResult": { "$ref": "urn:morivyx:plugin-communication:0.1#/$defs/RunResult" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
