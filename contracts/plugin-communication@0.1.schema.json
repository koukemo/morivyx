{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:morivyx:plugin-communication:0.1",
  "oneOf": [
    { "$ref": "#/$defs/RunRequest" },
    { "$ref": "#/$defs/RunResult" }
  ],
  "$defs": {
    "PluginIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "effect": {
          "enum": [
            "pure",
            "read-only",
            "artifact-write",
            "external-effect",
            "physical-effect"
          ]
        }
      }
    },
    "RunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "runId", "plugin", "capability", "input"],
      "properties": {
        "format": { "const": "morivyx.plugin-run-request/0.1" },
        "runId": { "type": "string", "minLength": 1 },
        "plugin": { "$ref": "#/$defs/PluginIdentity" },
        "capability": { "$ref": "#/$defs/Capability" },
        "input": { "type": "object" }
      }
    },
    "Failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "RunResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "runId", "plugin", "capabilityId", "status", "output"],
          "properties": {
            "format": { "const": "morivyx.plugin-run-result/0.1" },
            "runId": { "type": "string", "minLength": 1 },
            "plugin": { "$ref": "#/$defs/PluginIdentity" },
            "capabilityId": { "type": "string", "minLength": 1 },
            "status": { "const": "success" },
            "output": { "type": "object" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "runId", "plugin", "capabilityId", "status", "failure"],
          "properties": {
            "format": { "const": "morivyx.plugin-run-result/0.1" },
            "runId": { "type": "string", "minLength": 1 },
            "plugin": { "$ref": "#/$defs/PluginIdentity" },
            "capabilityId": { "type": "string", "minLength": 1 },
            "status": { "const": "failure" },
            "failure": { "$ref": "#/$defs/Failure" }
          }
        }
      ]
    },
    "RepositoryReadInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryRoot", "externalId", "locator"],
      "properties": {
        "repositoryRoot": { "type": "string", "minLength": 1 },
        "externalId": { "type": "string", "minLength": 1 },
        "locator": { "type": "string", "minLength": 1 }
      }
    },
    "RepositoryFileSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "externalIdentity", "locator", "digest", "digestRule", "retrievedAt"],
      "properties": {
        "kind": { "const": "repository-file-snapshot" },
        "externalIdentity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "externalId"],
          "properties": {
            "system": { "const": "repository" },
            "externalId": { "type": "string", "minLength": 1 }
          }
        },
        "locator": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "digestRule": { "const": "sha256-bytes" },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
