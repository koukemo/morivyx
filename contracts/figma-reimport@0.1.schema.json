{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:morivyx:figma-reimport:0.1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "externalIdentity", "locator", "previous", "current", "status", "issues"],
  "properties": {
    "format": { "const": "morivyx.figma-import-comparison/0.1" },
    "externalIdentity": { "oneOf": [{ "type": "null" }, {
      "type": "object", "additionalProperties": false, "required": ["system", "fileKey", "externalId"],
      "properties": { "system": { "const": "figma" }, "fileKey": { "$ref": "#/$defs/Key" }, "externalId": { "type": "string", "minLength": 1 } }
    }] },
    "locator": { "type": ["string", "null"] },
    "previous": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Descriptor" }] },
    "current": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/Resolved" }, { "$ref": "#/$defs/Failure" }] },
    "status": { "enum": ["current", "stale", "missing", "unavailable", "invalid"] },
    "issues": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string", "pattern": "^FIGMA_REIMPORT_[A-Z_]+$" } } } }
  },
  "$defs": {
    "Key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "Digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "Descriptor": {
      "type": "object", "additionalProperties": false, "required": ["version", "digest", "digestRule", "retrievedAt"],
      "properties": { "version": { "$ref": "#/$defs/Key" }, "digest": { "$ref": "#/$defs/Digest" }, "digestRule": { "const": "sha256-sorted-json-node/0.1" }, "retrievedAt": { "type": "string", "format": "date-time" } }
    },
    "Resolved": {
      "type": "object", "additionalProperties": false, "required": ["status", "version", "digest", "digestRule", "retrievedAt"],
      "properties": { "status": { "const": "resolved" }, "version": { "$ref": "#/$defs/Key" }, "digest": { "$ref": "#/$defs/Digest" }, "digestRule": { "const": "sha256-sorted-json-node/0.1" }, "retrievedAt": { "type": "string", "format": "date-time" } }
    },
    "Failure": {
      "type": "object", "additionalProperties": false, "required": ["status", "failureCode", "requestedVersion"],
      "properties": { "status": { "enum": ["missing", "unavailable"] }, "failureCode": { "enum": ["FIGMA_IMPORT_TARGET_MISSING", "FIGMA_IMPORT_SOURCE_UNAVAILABLE", "FIGMA_IMPORT_TIMEOUT"] }, "requestedVersion": { "$ref": "#/$defs/Key" } }
    }
  }
}
